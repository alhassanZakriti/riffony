# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL) — required once Better Auth is enabled
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Social auth (leave disabled until credentials are set)
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ENABLE_FACEBOOK_AUTH=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

ENABLE_X_AUTH=false
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Email delivery (optional until configured)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
